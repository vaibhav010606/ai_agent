#!/home/vp/Desktop/ai_agent/linux_agent/venv/bin/python
import sys
import base64
import os
from io import BytesIO
from PIL import ImageGrab
from groq import Groq
from dotenv import load_dotenv

load_dotenv('/home/vp/Desktop/ai_agent/linux_agent/.env')

def main():
    if len(sys.argv) < 2:
        print("Usage: analyze_screen <prompt>")
        sys.exit(1)
    prompt = sys.argv[1]
    
    try:
        img = ImageGrab.grab()
        buffered = BytesIO()
        img.save(buffered, format="JPEG", quality=80)
        img_str = base64.b64encode(buffered.getvalue()).decode('utf-8')
        
        api_key_str = os.getenv("GROQ_API_KEYS") or os.getenv("GROQ_API_KEY")
        if not api_key_str:
            print("Error: No Groq API key found.")
            sys.exit(1)
            
        api_key = api_key_str.split(',')[0].strip()
        client = Groq(api_key=api_key)
        
        completion = client.chat.completions.create(
            model="llama-3.2-11b-vision-preview",
            messages=[
                {
                    "role": "user",
                    "content": [
                        {"type": "text", "text": prompt},
                        {
                            "type": "image_url",
                            "image_url": {
                                "url": f"data:image/jpeg;base64,{img_str}"
                            }
                        }
                    ]
                }
            ],
            temperature=0,
            max_tokens=1024,
        )
        print(completion.choices[0].message.content)
    except Exception as e:
        print(f"Error analyzing screen: {e}")

if __name__ == "__main__":
    main()
